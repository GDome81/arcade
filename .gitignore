.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ── Editors / IDEs ────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ── Logs / temp ───────────────────────────────────
*.log
*.tmp
*.bak
*.orig

# ── Node (for any tooling) ────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.npm/

# ── Local dev artefacts ───────────────────────────
.cache/
.parcel-cache/
dist/
build/

# ── Claude / AI tooling ───────────────────────────
.claude/
.aider*
.cursor/

# ── Asset archives & source packs ─────────────────
# In each game folder, raw .zip downloads and the full unpacked vendor packs
# (e.g. kenney_racing/) stay local. The sprites actually used by the game
# are duplicated under <game>/assets/game/ and committed from there.
**/assets/*.zip
**/assets/*.tar.gz
**/assets/kenney_*/

# ── PartyKit / Cloudflare Workers build cache ─────
multiplayer/.partykit/
multiplayer/.wrangler/
